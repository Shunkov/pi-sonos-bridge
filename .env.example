# Copy to /etc/pi-sonos-bridge.env on the Pi (install.sh does this for you),
# or to .env next to docker-compose.yml for the Docker demo.
ICECAST_SOURCE_PASSWORD=change-this-to-a-long-random-string
ICECAST_PUBLIC_HOST=raspberrypi.local

# pipewire (both inputs, recommended) | direct (line-in only) | test_tone
AUDIO_MODE=pipewire
PULSE_SOURCE=sonos_stream.monitor
ALSA_DEVICE=hw:2,0

AUDIO_BITRATE_KBPS=192
# LINEIN_SOURCE_MATCH=alsa_input.usb
